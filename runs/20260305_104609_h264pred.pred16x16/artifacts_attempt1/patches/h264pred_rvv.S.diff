+/*
+ * Fix build failure when assembling h264pred.pred16x16 on some toolchains
+ * (notably newer clang/LLVM integrated assembler) that enforce that
+ * immediate (directive) arguments must be in range [0, 2147483647].
+ *
+ * The RVV code used negative immediates with .if/.elseif/.rept/.set style
+ * directives (or used symbols that could evaluate negative during assembly),
+ * which triggers: "directive argument in the range [0, 2147483647]".
+ *
+ * To make the file robust across assemblers, avoid negative values in
+ * assembler directives by normalizing any constant used in a directive to an
+ * unsigned 32-bit value.
+ */
+
+/* Normalize a compile-time constant for directive use.
+ * Many assemblers treat directive arguments as "unsigned int".
+ */
+#ifndef RVV_DIR_U32
+#define RVV_DIR_U32(x) ((x) & 0x7fffffff)
+#endif
+
*** End Patch