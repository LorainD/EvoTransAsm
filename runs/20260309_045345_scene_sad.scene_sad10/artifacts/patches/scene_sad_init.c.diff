+#include "config.h"
+
+#include "libavutil/cpu.h"
+#include "libavutil/riscv/cpu.h"
+#include "libavfilter/scene_sad.h"
+
+#if HAVE_RVV
+void ff_scene_sad10_rvv(SCENE_SAD_PARAMS);
+
+static void scene_sad10_rvv_wrapper(SCENE_SAD_PARAMS)
+{
+    uint64_t sad = 0;
+    *sum = 0;
+    ff_scene_sad10_rvv(src1, stride1, src2, stride2, width, height, &sad);
+    *sum = sad;
+}
+#endif
+
+ff_scene_sad_fn ff_scene_sad_get_fn_riscv(int depth)
+{
+#if HAVE_RVV
+    const int flags = av_get_cpu_flags();
+    if (flags & AV_CPU_FLAG_RVV) {
+        if (depth == 10)
+            return scene_sad10_rvv_wrapper;
+    }
+#endif
+    return NULL;
+}
