 #include "config.h"
 
 #include "libavutil/attributes.h"
 #include "libavutil/cpu.h"
 #include "libavutil/riscv/cpu.h"
 
 #include "libavcodec/synth_filter.h"
 
 void ff_synth_filter_float_rvv(AVTXContext *imdct,
                                float *synth_buf_ptr, int *synth_buf_offset,
                                float synth_buf2[32], const float window[512],
                                float out[32], float in[32], float scale,
                                av_tx_fn imdct_fn);
 
 /*
  * Determine RVV availability.
  *
- * Do not reference AV_CPU_FLAG_RVV directly: depending on the FFmpeg version
- * and configuration, the public flag may not exist (leading to compilation
- * errors). The canonical helper in libavutil/riscv/cpu.h is the preferred API.
+ * Use the public CPU flag when available in this FFmpeg revision.
+ * Avoid calling internal helpers that may not exist across versions.
  */
 static av_always_inline int ff_rvv_available(void)
 {
 #if HAVE_RVV
-    /* libavutil/riscv/cpu.h provides this helper when RVV support is enabled */
-    return ff_rvv_have_rvv();
+    return av_get_cpu_flags() & AV_CPU_FLAG_RVV;
 #else
     return 0;
 #endif
 }
 
 av_cold void ff_synth_filter_init_riscv(SynthFilterContext *s);
 
 av_cold void ff_synth_filter_init_riscv(SynthFilterContext *s)
 {
 #if HAVE_RVV
     if (ff_rvv_available())
         s->synth_filter_float = ff_synth_filter_float_rvv;
 #else
     (void)s;
 #endif
 }
